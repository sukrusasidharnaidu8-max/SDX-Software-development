# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database Configuration (PostgreSQL / Supabase / Neon / Local)
# Example: postgresql://postgres:password@localhost:5432/sdx_db?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/sdx_db?schema=public"

# Authentication & Security
# Generate with: openssl rand -base64 32
JWT_SECRET="sdx_super_secret_jwt_key_development_2026_change_in_production"
JWT_EXPIRES_IN="7d"

# Nodemailer / SMTP Email Notification Settings
# All contact form submissions send alert to: sdxsoftwaredevelopment@gmail.com
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="sdxsoftwaredevelopment@gmail.com"
SMTP_PASSWORD="your-google-app-password-here"
EMAIL_FROM="\"SDX Software Development\" <sdxsoftwaredevelopment@gmail.com>"
ADMIN_NOTIFICATION_EMAIL="sdxsoftwaredevelopment@gmail.com"

# Razorpay Payment Gateway (Test & Live)
# Get credentials from https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# Google Services Integration
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="google-site-verification-token-here"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXX"

# Cloudflare / CDN Config (Optional)
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_TOKEN=""
